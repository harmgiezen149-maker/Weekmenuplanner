# Upstash Redis (REST) — uit je Upstash database-dashboard
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic API key — voor foto/link-import (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Token voor de iOS-Shortcut die een receptlink naar de tracker stuurt.
# Verzin zelf een lange, willekeurige tekst. Laat je hem leeg, dan werkt de
# Shortcut niet maar de rest van de app gewoon wel.
TRACKER_IMPORT_TOKEN=
